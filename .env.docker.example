# ============================================================================
# Cấu hình Docker Compose cho Taskify.
#
# CÁCH DÙNG (khuyến nghị):   .\scripts\init-env.ps1
#   -> tự tạo file .env với secret / mật khẩu NGẪU NHIÊN, an toàn. Không ghi đè .env đang có.
#
# Làm thủ công:  Copy-Item .env.docker.example .env  rồi ĐIỀN các giá trị bắt buộc bên dưới.
# TUYỆT ĐỐI không commit file .env, và không dùng lại bất kỳ secret mẫu/công khai nào.
# ============================================================================

# prod = chạy thật (không seed dữ liệu demo) · dev = máy phát triển (có dữ liệu demo, Swagger)
SPRING_PROFILES_ACTIVE=prod

# Dữ liệu demo — chỉ có tác dụng khi SPRING_PROFILES_ACTIVE=dev
APP_SEED_ENABLED=false
# Email gốc nhận OTP của tài khoản demo, ví dụ ten@gmail.com -> ten+admin@gmail.com, ten+lecturer@gmail.com
APP_SEED_OTP_EMAIL=

# Bản cài production mới: tạo tài khoản ADMIN đầu tiên (chỉ khi chưa có ADMIN nào).
# Tài khoản chưa kích hoạt; mã kích hoạt gửi tới email này để tự đặt mật khẩu. Xóa hai biến sau lần chạy đầu.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=

MYSQL_DATABASE=doan_ltmmt
MYSQL_USER=ktpm
# BẮT BUỘC (để trống thì docker compose từ chối chạy): mật khẩu MySQL
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5175

# BẮT BUỘC: secret ký JWT = chuỗi base64 của >= 32 byte NGẪU NHIÊN.
# Sinh bằng:  .\scripts\init-env.ps1   (hoặc: openssl rand -base64 48)
JWT_SECRET=
# Access token sống 15 phút (giữ trong bộ nhớ trình duyệt); phiên được duy trì bằng refresh token
# xoay vòng trong cookie HttpOnly, sống APP_AUTH_REFRESH_TTL_DAYS ngày (P3-14)
JWT_EXPIRATION=900000
APP_AUTH_REFRESH_TTL_DAYS=7
# Cookie refresh chỉ gửi qua HTTPS. Chạy thử bằng http://localhost thì đặt false.
APP_AUTH_REFRESH_COOKIE_SECURE=true

# CORS phải khớp địa chỉ frontend bạn mở ra
APP_CORS_ALLOWED_ORIGINS=http://localhost:5175

# Gửi email OTP/thông báo (Gmail: dùng "App Password", không dùng mật khẩu đăng nhập)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.local
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# P4-08 — giám sát (docker compose --profile monitoring up -d). Token để Prometheus đọc /actuator/prometheus:
# sinh bằng `openssl rand -hex 32`; để trống = endpoint số liệu bị tắt. Grafana: http://127.0.0.1:3000 (admin / mật khẩu dưới;
# để trống thì Grafana dùng admin/admin và bắt đổi ở lần đăng nhập đầu).
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
