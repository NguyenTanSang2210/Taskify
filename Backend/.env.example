# Cấu hình backend khi chạy LOCAL (không Docker). Tạo file .env tự động: .\scripts\init-env.ps1
# Không commit file .env thật.

# Runtime profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/doan_ltmmt?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# JWT: chuỗi base64 của >= 32 byte NGẪU NHIÊN. Để trống ở profile dev sẽ dùng khóa dev công khai (chỉ để thử);
# ở prod bắt buộc phải đặt (ứng dụng từ chối khởi động nếu thiếu / dùng khóa công khai).
JWT_SECRET=
# Access token 15 phút (P3-14); phiên dài nhờ refresh token trong cookie HttpOnly (mặc định 7 ngày)
JWT_EXPIRATION=900000
APP_AUTH_REFRESH_TTL_DAYS=7
# Token tạm cho bước nhập OTP / đổi mật khẩu bắt buộc (mili giây, mặc định 10 phút)
JWT_PREAUTH_EXPIRATION=600000

# App toggles
APP_SEED_ENABLED=true
# Email gốc nhận OTP của tài khoản demo, ví dụ ten@gmail.com -> ten+admin@gmail.com
APP_SEED_OTP_EMAIL=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5175

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.local
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
